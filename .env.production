# GACS Dashboard - Production Environment Configuration
# Copy to .env in production

# Application
APP_URL=https://yourdomain.com
APP_ENV=production
APP_DEBUG=false

# Database Configuration
DB_HOST=localhost
DB_NAME=gacs_prod
DB_USER=gacs_prod
DB_PASSWORD=your_secure_password_here

# Application Settings
APP_TIMEZONE=Asia/Jakarta
SESSION_NAME=GACS_SESSION
SESSION_LIFETIME=3600
SESSION_SECURE=true
SESSION_HTTP_ONLY=true

# Default Admin Credentials (Change after first login!)
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=ChangeMeAfterFirstLogin!

# GenieACS Configuration
GENIEACS_HOST=acs.yourdomain.com
GENIEACS_PORT=7557
GENIEACS_USER=admin
GENIEACS_PASS=
GENIEACS_TIMEOUT=30

# MikroTik Configuration
MIKROTIK_HOST=
MIKROTIK_PORT=8728
MIKROTIK_USER=
MIKROTIK_PASS=
MIKROTIK_TIMEOUT=30

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhook/telegram.php
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Security
CSRF_TOKEN_LENGTH=32
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_REQUIRE_NUMBERS=true

# Logging
LOG_LEVEL=warning
LOG_MAX_SIZE=10M
LOG_RETENTION_DAYS=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/var/backups/gacs-dashboard/

# Monitoring
MONITORING_ENABLED=true
MONITORING_INTERVAL=300
MONITORING_TIMEOUT=30
